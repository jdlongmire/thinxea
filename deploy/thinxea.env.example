# Copy to /opt/thinxea/thinxea.env (mode 600) on the host.
THINXEA_PROVIDER=claude_cli
THINXEA_CLI_MODEL=
THINXEA_CLI_TIMEOUT=180
THINXEA_CLI_CONCURRENCY=2
THINXEA_DB=/opt/thinxea/data/thinxea.db
THINXEA_MODEL_PATH=/opt/thinxea/web/data/model.json
THINXEA_WORKDIR=/opt/thinxea/work
THINXEA_DAILY_REQUESTS=40
THINXEA_DAILY_TOKENS=200000
THINXEA_GLOBAL_DAILY_REQUESTS=300
THINXEA_SESSION_DAYS=7
THINXEA_ACCOUNT_DAYS=14
